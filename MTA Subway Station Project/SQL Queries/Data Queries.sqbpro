--Query 1: What are the busiest subway stations?

This establishes the overall station performance baseline.

SELECT
    station_complex,
    borough,
    SUM(ridership) AS total_ridership
FROM subway
GROUP BY
    station_complex_id,
    station_complex,
    borough
ORDER BY total_ridership DESC
LIMIT 10;

-- Returns subway stations handling the greatest volume of passenger activity

-- Query 2: Which boroughs have the highest ridership?

SELECT
    borough,
    SUM(ridership) AS total_ridership,
    ROUND(AVG(ridership), 0) AS avg_monthly_ridership
FROM subway
GROUP BY borough
ORDER BY total_ridership DESC;

-- Query 3: How has NYC subway ridership changed over time?

SELECT
    month,
    SUM(ridership) AS total_ridership
FROM subway
GROUP BY month
ORDER BY month;

-- Query 4: What is the year-over-year change in ridership?

WITH yearly_ridership AS (
    SELECT
        substr(month, 7, 4) AS year,
        SUM(CAST(REPLACE(ridership, ',', '') AS INTEGER)) AS total_ridership
    FROM subway
    GROUP BY substr(month, 7, 4)
)

SELECT
    year,
    total_ridership,
    LAG(total_ridership) OVER (ORDER BY CAST(year AS INTEGER)) 
	AS previous_year_ridership,

    ROUND(
       (total_ridership - LAG(total_ridership) OVER (ORDER BY CAST(year AS INTEGER))) * 100.0
        / NULLIF(LAG(total_ridership) OVER (ORDER BY CAST(year AS INTEGER)), 0),2
        ) AS yoy_change_pct

FROM yearly_ridership

ORDER BY CAST(year AS INTEGER);

-- Make note, we must account for the incomplete year of 2026 as we received data up to June 2026 this year
-- Additionally, for 2017 we are only missing data from the month of January, so would be inpactful towards year over year change in percentage.


-- Query #5: How does ridership change across boroughs over time?

SELECT
    month,
    borough,
    SUM(CAST(REPLACE(ridership, ',', '') AS INTEGER)) AS total_ridership
FROM subway
GROUP BY
    month,
    borough
ORDER BY
    CAST(substr(month, 7, 4) AS INTEGER),
    CAST(substr(month, 1, 2) AS INTEGER),
    borough;
	
-- Query #6: How has total annual ridership changed?

SELECT
    substr(month, 7, 4) AS year,
    SUM(CAST(REPLACE(ridership, ',', '') AS INTEGER)) AS total_ridership
FROM subway
GROUP BY substr(month, 7, 4)
ORDER BY CAST(year AS INTEGER);

-- Query #7: COVID impact: compare each year with 2019

WITH yearly_ridership AS (
    SELECT
        substr(month, 7, 4) AS year,
        SUM(CAST(REPLACE(ridership, ',', '') AS INTEGER)) AS total_ridership
    FROM subway
    GROUP BY substr(month, 7, 4)
),

baseline AS (
    SELECT total_ridership AS ridership_2019
    FROM yearly_ridership
    WHERE year = '2019'
)

SELECT
    year,
    total_ridership,

    ROUND(100.0 * total_ridership / ridership_2019, 2) AS pct_of_2019,

    ROUND(100.0 * (total_ridership - ridership_2019) / ridership_2019, 2) AS change_vs_2019_pct

FROM yearly_ridership
CROSS JOIN baseline
ORDER BY CAST(year AS INTEGER);

-- 2019 baseline → 2020 decline → 2021 recovery → 2022 recovery → 2023 → 2024 → 2025 → partial 2026
-- And importantly, did not compare 2026 with the full-year figures because the dataset only has January–June 2026.

-- Query #8: Which stations function as the biggest transfer hubs?

SELECT
    station_complex,
    borough,
    SUM(CAST(REPLACE(transfers, ',', '') AS INTEGER)) AS total_transfers,
    SUM(CAST(REPLACE(ridership, ',', '') AS INTEGER)) AS total_ridership
FROM subway
GROUP BY
    station_complex_id,
    station_complex,
    borough
ORDER BY total_transfers DESC
LIMIT 10;

-- Query #9: Which stations have the highest transfer activity relative to their ridership?

SELECT
    station_complex,
    borough,
    SUM(CAST(REPLACE(transfers, ',', '') AS INTEGER)) AS total_transfers,
    SUM(CAST(REPLACE(ridership, ',', '') AS INTEGER)) AS total_ridership,
    ROUND(
        100.0 *
        SUM(CAST(REPLACE(transfers, ',', '') AS INTEGER))
        /
        NULLIF(SUM(CAST(REPLACE(ridership, ',', '') AS INTEGER)),0), 2
       ) AS transfer_rate_pct

FROM subway

GROUP BY
    station_complex_id,
    station_complex,
    borough
HAVING SUM(CAST(REPLACE(ridership, ',', '') AS INTEGER)) &gt; 0
ORDER BY transfer_rate_pct DESC
LIMIT 10;

-- Query #10:  Top 3 stations within each borough

  -- Step 1: Calculate total ridership for each station
    -- REPLACE removes commas from values such as '125,000'
    -- CAST converts the text value into an integer
    -- SUM adds the monthly ridership for each station

WITH station_ridership AS (
    SELECT
        station_complex_id,
        station_complex,
        borough,
        SUM(CAST(REPLACE(ridership, ',', '') AS INTEGER)) AS total_ridership
    FROM subway
    GROUP BY
        station_complex_id,
        station_complex,
        borough
       ),

-- Step 2: Rank stations within each borough
    -- PARTITION BY borough means each borough gets
    -- its own separate ranking
    -- ORDER BY total_ridership DESC puts the busiest
    -- station at rank 1

ranked_stations AS (
    SELECT
        station_complex,
        borough,
        total_ridership,

        RANK() OVER (PARTITION BY borough ORDER BY total_ridership DESC) AS borough_rank
        FROM station_ridership
        )
		
-- Step 3: Return the results
-- Only keep stations ranked 1, 2, or 3
-- within their respective borough

SELECT
    borough,
    borough_rank,
    station_complex,
    total_ridership

FROM ranked_stations

WHERE borough_rank &lt;= 3

ORDER BY
    borough,
    borough_rank;
    </sql><current_tab id="0"/></tab_sql></sqlb_project>
