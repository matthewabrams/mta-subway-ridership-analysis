SELECT COUNT(*) AS total_rows
FROM subway;

-- Check the date/month values
SELECT COUNT(DISTINCT month) AS unique_months
FROM subway;

-- For chronological ordering, use:
SELECT DISTINCT month
FROM subway
ORDER BY 
    substr(month, 4, 4),
    substr(month, 1, 2);

--You can check how many unique months you actually have:	
SELECT COUNT(DISTINCT month) AS unique_months
FROM subway; 

-- Counting number of months per year
SELECT 
    substr(month, 7, 4) AS year,
    COUNT(DISTINCT month) AS months
FROM subway
GROUP BY year
ORDER BY year;
--Note starting month is in Feb 2017 and ending month is Jun 2026

--Checking for NULL
SELECT * FROM subway
WHERE COALESCE(borough, ridership, transfers) IS NULL;

-- Checking for duplicates
SELECT 
    station_complex_id,
	station_complex,
    month,
    borough,
    COUNT(*) AS duplicate_count
FROM subway
GROUP BY  station_complex_id, station_complex, month, borough
HAVING COUNT(*)  &gt; 1;</sql><current_tab id="0"/></tab_sql></sqlb_project>
